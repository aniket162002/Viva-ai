# VivaAI - Environment Configuration File
# -------------------------------------------------------------
# IMPORTANT CONSTRAINTS:
# VivaAI operates 100% client-side in the user's browser.
# NO EXTERNAL API KEYS (OpenAI, Anthropic, Gemini, etc.) ARE REQUIRED OR CONSUMED FOR INFERENCE.
# All LLM inference (@mlc-ai/web-llm), OCR (tesseract.js), and Speech-to-Text (Web Speech API / HuggingFace Transformers)
# execute locally on the browser via WebGPU / WebAssembly.
# -------------------------------------------------------------

# Next.js Application Environment
NEXT_PUBLIC_APP_NAME="VivaAI — Browser AI Project Examiner"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local Storage & Database Configuration (IndexedDB for offline client-side persistence)
INDEXEDDB_DB_NAME="vivaai-local"
INDEXEDDB_VERSION=1


